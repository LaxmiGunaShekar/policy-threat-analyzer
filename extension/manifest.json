{
  "manifest_version": 3,
  "name": "Policy Safeguard",
  "version": "1.0.0",
  "description": "Analyzes Terms of Service and Privacy Policies for predatory clauses and summarizes them in plain English.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
